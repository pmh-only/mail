{
  "name": "mail",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite dev",
    "dev:worker": "dotenv -- node scripts/dev-worker.mjs",
    "dev:worker:build": "vite build --config vite.worker.config.ts --watch",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "start:web": "node server.js",
    "start:worker": "node build-worker/worker.js",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "husky",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "test": "DEMO_MODE=true vitest run",
    "test:frontend": "DEMO_MODE=true vitest run .svelte.test.ts",
    "test:coverage": "DEMO_MODE=true vitest run --coverage",
    "lint": "oxfmt --check . && oxlint --deny-warnings",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.1",
    "@tiptap/core": "^3.30.4",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "better-auth": "1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "imapflow": "^1.7.2",
    "lucide-svelte": "^1.0.1",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "openpgp": "^6.3.1",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "cytoscape": "^3.34.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "search-insights": "^2.17.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0"
}
