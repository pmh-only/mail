{
  "name": "mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite dev",
    "dev:worker": "dotenv run node scripts/dev-worker.mjs",
    "dev:worker:build": "vite build --config vite.worker.config.ts --watch",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "vite preview",
    "start:web": "node server.js",
    "start:worker": "node build-worker/worker.js",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "husky",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "test": "DEMO_MODE=true vitest run",
    "test:coverage": "DEMO_MODE=true vitest run --coverage",
    "lint": "oxfmt --check . && oxlint --deny-warnings",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.25",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-auth": "1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^10.0.0",
    "htmlparser2": "^12.0.0",
    "imapflow": "^1.6.5",
    "lucide-svelte": "^1.0.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.4",
    "openai": "^7.3.0",
    "openpgp": "^6.3.1",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
